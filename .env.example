# 运行 ./setup.sh 生成随机密钥和目录。不要公开真实 .env。
APP_TOKEN=replace_with_at_least_24_random_characters
OPENLIST_PASSWORD=replace_with_random_password
PUID=1000
PGID=1000
BIND_IP=127.0.0.1
APP_PORT=8080
OPENLIST_PORT=5244
CONNECTIONS_PER_FILE=8
ACTIVE_DOWNLOADS=2
GLOBAL_CONNECTIONS=24
COOKIE_SECURE=false

# Leave empty to choose by actual Baidu membership (normal 1 / VIP 4 / SVIP 8).
BAIDU_CONNECTIONS=

# Optional self-hosted Microsoft / Google OAuth (use a registered HTTPS callback).
PUBLIC_URL=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional upstream proxy reachable from both containers (not container localhost).
CLOUD_HTTPS_PROXY=
CLOUD_HTTP_PROXY=
CLOUD_NO_PROXY=openlist,localhost,127.0.0.1
